VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_MAPBOX_ACCESS_TOKEN=

# Server-only (TanStack Start). Never prefix with VITE_ — keeps the key off the client.
RESEND_API_KEY=re_xxxxxxxx

# Firebase Cloud Messaging. The VITE_ values are public web config.
# FIREBASE_SERVICE_ACCOUNT is the service-account JSON on one line. Server only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Server-only. Lets the app read push tokens when sending a notice.
NOTIFY_INTERNAL_SECRET=
